@model Pharmacy.ViewModels.LoginVM

@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-dark text-white text-center py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">
                        <i class="fa-solid fa-right-to-bracket me-2 text-primary"></i>Welcome Back
                    </h4>
                    <p class="small mb-0 text-white-50 mt-1">Sign in to access your PharmaCare account</p>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">

                    <!-- Server-Side Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3 small" role="alert"></div>

                    <form asp-controller="Account" asp-action="Login" method="post">

                        <!-- Username or Email -->
                        <div class="mb-3">
                            <label asp-for="UsernameOrEmail" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-secondary"><i class="fa-solid fa-circle-user"></i></span>
                                <input asp-for="UsernameOrEmail" class="form-control border-start-0 ps-0" placeholder="Username or Email address" />
                            </div>
                            <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-secondary"><i class="fa-solid fa-lock"></i></span>
                                <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="RememberMe" />
                                <label class="form-check-label text-secondary small" asp-for="RememberMe"></label>
                            </div>
                            <a asp-action="ForgetPassword" class="small text-decoration-none">Forgot password?</a>
                            <a asp-action="ResendEmailConfirmation" class="small text-decoration-none">Resend Email Confirmation</a>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                        </button>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <span class="text-muted small">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="fw-bold text-decoration-none ms-1">Create One</a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}