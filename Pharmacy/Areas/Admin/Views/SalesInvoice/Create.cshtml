@model Pharmacy.ViewModels.SalesInvoiceVM

@{
    ViewData["Title"] = "Create Sales Invoice";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Create Sales Invoice</h2>
            <p class="text-muted mb-0">
                Create a new offline customer sales invoice
            </p>
        </div>

        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Back
        </a>
    </div>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>

        <div class="row g-4">

            <!-- ================= INVOICE INFO ================= -->

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <h5 class="fw-bold mb-4">
                            Invoice Information
                        </h5>

                        <div class="mb-3">

                            <label asp-for="InvoiceNumber"
                                   class="form-label">
                                Invoice #
                            </label>

                            <input asp-for="InvoiceNumber"
                                   class="form-control"
                                   placeholder="EN-01" />

                            <span asp-validation-for="InvoiceNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="InvoiceDate"
                                   class="form-label">
                                Date
                            </label>

                            <input asp-for="InvoiceDate"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="InvoiceDate"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="CustomerId"
                                   class="form-label">
                                Offline Customer
                            </label>

                            <select asp-for="CustomerId"
                                    asp-items="Model.Customers"
                                    class="form-select">

                                <option value="">
                                    -- Select Customer --
                                </option>

                            </select>

                        </div>

                        <div class="text-center my-3 text-muted">
                            OR
                        </div>

                        <div class="mb-3">

                            <label asp-for="OrderId"
                                   class="form-label">
                                Online Order
                            </label>

                            <select asp-for="OrderId"
                                    asp-items="Model.Orders"
                                    class="form-select">

                                <option value="">
                                    -- Select Order --
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Discount"
                                   class="form-label">
                                Discount
                            </label>

                            <input asp-for="Discount"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   id="discount" />

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= ITEMS ================= -->

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between
                            align-items-center mb-4">

                            <h5 class="fw-bold mb-0">
                                Invoice Items
                            </h5>

                            <button type="button"
                                    id="addItem"
                                    class="btn btn-primary btn-sm">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add Item

                            </button>

                        </div>

                        <div id="itemsContainer">

                            @for (int i = 0; i < Model.InvoiceItems.Count; i++)
                            {
                                <div class="invoice-item border rounded p-3 mb-3">

                                    <div class="row g-3 align-items-end">

                                        <div class="col-md-6">

                                            <label class="form-label">
                                                Product Batch
                                            </label>

                                            <select name="InvoiceItems[@i].ProductBatchId"
                                                    class="form-select batch-select">

                                                <option value="">
                                                    -- Select Batch --
                                                </option>

                                                @foreach (var batch in
                                                    (IEnumerable<SelectListItem>)ViewBag.Batches)
                                                {
                                                    <option value="@batch.Value"
                                                            selected="@(batch.Value == Model.InvoiceItems[i].ProductBatchId.ToString() ? "selected" : null)">
                                                        @batch.Text
                                                    </option>
                                                }

                                            </select>

                                        </div>

                                        <div class="col-md-3">

                                            <label class="form-label">
                                                Quantity
                                            </label>

                                            <input type="number"
                                                   name="InvoiceItems[@i].Quantity"
                                                   value="@Model.InvoiceItems[i].Quantity"
                                                   min="1"
                                                   class="form-control quantity-input" />

                                        </div>

                                        <div class="col-md-3">

                                            <button type="button"
                                                    class="btn btn-outline-danger remove-item w-100">

                                                <i class="bi bi-trash"></i>
                                                Remove

                                            </button>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Total
                            </span>

                            <strong id="totalDisplay">
                                0.00 EGP
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Discount
                            </span>

                            <strong id="discountDisplay">
                                0.00 EGP
                            </strong>

                        </div>

                        <div class="d-flex justify-content-between">

                            <span class="fw-bold fs-5">
                                Net Amount
                            </span>

                            <strong class="fw-bold fs-5"
                                    id="netDisplay">
                                0.00 EGP
                            </strong>

                        </div>

                        <div class="mt-4">

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bi bi-check-lg me-1"></i>
                                Create Invoice

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let itemIndex =
            document.querySelectorAll(".invoice-item").length;

        const container =
            document.getElementById("itemsContainer");

        const addButton =
            document.getElementById("addItem");

        const discountInput =
            document.getElementById("discount");


        // ============================================
        // Batches HTML
        // ============================================

        const batches = [

                    @foreach (var batch in
    (IEnumerable<SelectListItem>)ViewBag.Batches)
            {
                <text>
                        {
                            value: "@batch.Value",
                        text: "@Html.Raw(batch.Text)"
                                },
                </text>
                    }

                ];


        // ============================================
        // Add Item
        // ============================================

        addButton.addEventListener("click", function () {

            const index = itemIndex++;

            let options =
                `<option value="">-- Select Batch --</option>`;

            batches.forEach(batch => {

                options +=
                    `<option value="${batch.value}">
                                ${batch.text}
                            </option>`;

            });


            const html = `

                        <div class="invoice-item border rounded p-3 mb-3">

                            <div class="row g-3 align-items-end">

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Product Batch
                                    </label>

                                    <select
                                        name="InvoiceItems[${index}].ProductBatchId"
                                        class="form-select batch-select">

                                        ${options}

                                    </select>

                                </div>


                                <div class="col-md-3">

                                    <label class="form-label">
                                        Quantity
                                    </label>

                                    <input
                                        type="number"
                                        name="InvoiceItems[${index}].Quantity"
                                        value="1"
                                        min="1"
                                        class="form-control quantity-input" />

                                </div>


                                <div class="col-md-3">

                                    <button
                                        type="button"
                                        class="btn btn-outline-danger
                                               remove-item w-100">

                                        <i class="bi bi-trash"></i>
                                        Remove

                                    </button>

                                </div>

                            </div>

                        </div>
                    `;

            container.insertAdjacentHTML("beforeend", html);

        });


        // ============================================
        // Remove Item
        // ============================================

        container.addEventListener("click", function (e) {

            const button =
                e.target.closest(".remove-item");

            if (!button)
                return;

            const items =
                document.querySelectorAll(".invoice-item");

            if (items.length <= 1) {

                alert("Invoice must contain at least one item.");

                return;
            }

            button.closest(".invoice-item").remove();

        });


        // ============================================
        // Discount
        // ============================================

        discountInput.addEventListener("input", function () {

            const discount =
                parseFloat(this.value) || 0;

            document.getElementById("discountDisplay")
                .innerText =
                discount.toFixed(2) + " EGP";

        });

    </script>
}