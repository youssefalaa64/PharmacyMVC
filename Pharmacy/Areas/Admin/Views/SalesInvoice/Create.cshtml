@model Pharmacy.ViewModels.SalesInvoiceVM

@{
    ViewData["Title"] = "Create Sales Invoice";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>
                Create Sales Invoice
            </h2>

            <p class="text-muted mb-0">
                Create a new offline sale or invoice for an online order.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-light border">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Invoices
        </a>

    </div>


    <!-- Validation -->
    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert">
        </div>


        <!-- ============================= -->
        <!-- Invoice Information -->
        <!-- ============================= -->

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white border-0 py-3">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-info-circle text-primary me-2"></i>
                    Invoice Information
                </h5>

            </div>

            <div class="card-body p-4">

                <div class="row g-4">

                    <!-- Invoice Number -->
                    <div class="col-md-4">

                        <label asp-for="InvoiceNumber"
                               class="form-label fw-semibold">
                            Invoice Number
                        </label>

                        <input asp-for="InvoiceNumber"
                               class="form-control"
                               placeholder="Enter invoice number" />

                        <span asp-validation-for="InvoiceNumber"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Invoice Date -->
                    <div class="col-md-4">

                        <label asp-for="InvoiceDate"
                               class="form-label fw-semibold">
                            Invoice Date
                        </label>

                        <input asp-for="InvoiceDate"
                               class="form-control"
                               type="datetime-local" />

                        <span asp-validation-for="InvoiceDate"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Discount -->
                    <div class="col-md-4">

                        <label asp-for="Discount"
                               class="form-label fw-semibold">
                            Discount
                        </label>

                        <div class="input-group">

                            <input asp-for="Discount"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   value="0" />

                            <span class="input-group-text">
                                EGP
                            </span>

                        </div>

                        <span asp-validation-for="Discount"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Customer -->
                    <div class="col-md-6">

                        <label asp-for="CustomerId"
                               class="form-label fw-semibold">

                            Offline Customer

                        </label>

                        <select asp-for="CustomerId"
                                asp-items="Model.Customers"
                                class="form-select">

                            <option value="">
                                -- No Offline Customer --
                            </option>

                        </select>

                        <div class="form-text">
                            Select a customer for an offline sale.
                        </div>

                    </div>


                    <!-- Order -->
                    <div class="col-md-6">

                        <label asp-for="OrderId"
                               class="form-label fw-semibold">

                            Online Order

                        </label>

                        <select asp-for="OrderId"
                                asp-items="Model.Orders"
                                class="form-select">

                            <option value="">
                                -- No Online Order --
                            </option>

                        </select>

                        <div class="form-text">
                            Select an online order if this invoice is related to an order.
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- Invoice Items -->
        <!-- ============================= -->

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white border-0 py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="fw-bold mb-1">
                            <i class="bi bi-cart3 text-primary me-2"></i>
                            Invoice Items
                        </h5>

                        <small class="text-muted">
                            Add the products and quantities included in this invoice.
                        </small>

                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            onclick="addInvoiceItem()">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Item

                    </button>

                </div>

            </div>


            <div class="card-body p-4">

                <div id="invoiceItemsContainer">

                    @for (int i = 0; i < Model.InvoiceItems.Count; i++)
                    {
                        <div class="row g-3 align-items-end invoice-item-row mb-3 p-3 border rounded bg-light">

                            <!-- Product Batch -->
                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Product Batch
                                </label>

                                <select name="InvoiceItems[@i].ProductBatchId"
                                        class="form-select">

                                    <option value="">
                                        -- Select Batch --
                                    </option>

                                    @foreach (var batch in ViewBag.Batches)
                                    {
                                        <option value="@batch.Value"
                                                selected="@(batch.Value == Model.InvoiceItems[i].ProductBatchId.ToString() ? "selected" : null)">
                                            @batch.Text
                                        </option>
                                    }

                                </select>

                            </div>


                            <!-- Quantity -->
                            <div class="col-md-2">

                                <label class="form-label fw-semibold">
                                    Quantity
                                </label>

                                <input name="InvoiceItems[@i].Quantity"
                                       value="@Model.InvoiceItems[i].Quantity"
                                       type="number"
                                       min="1"
                                       class="form-control quantity-input"
                                       onchange="calculateRowTotal(this)" />

                            </div>


                            <!-- Unit Price -->
                            <div class="col-md-3">

                                <label class="form-label fw-semibold">
                                    Unit Price
                                </label>

                                <div class="input-group">

                                    <input name="InvoiceItems[@i].UnitPrice"
                                           value="@Model.InvoiceItems[i].UnitPrice"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           class="form-control price-input"
                                           onchange="calculateRowTotal(this)" />

                                    <span class="input-group-text">
                                        EGP
                                    </span>

                                </div>

                            </div>


                            <!-- Total -->
                            <div class="col-md-2">

                                <label class="form-label fw-semibold">
                                    Total
                                </label>

                                <input value="@Model.InvoiceItems[i].TotalPrice"
                                       class="form-control total-input"
                                       readonly />

                            </div>


                            <!-- Delete -->
                            <div class="col-md-1">

                                <button type="button"
                                        class="btn btn-outline-danger w-100"
                                        onclick="removeInvoiceItem(this)"
                                        title="Remove Item">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </div>

                        </div>
                    }

                </div>


                <!-- Empty State -->
                @if (Model.InvoiceItems.Count == 0)
                {
                    <div id="emptyItemsMessage"
                         class="text-center py-5">

                        <i class="bi bi-cart-x display-5 text-muted"></i>

                        <h6 class="mt-3 fw-semibold">
                            No invoice items
                        </h6>

                        <p class="text-muted mb-3">
                            Add at least one product batch to the invoice.
                        </p>

                        <button type="button"
                                class="btn btn-outline-primary"
                                onclick="addInvoiceItem()">

                            <i class="bi bi-plus-lg me-1"></i>
                            Add First Item

                        </button>

                    </div>
                }

            </div>

        </div>


        <!-- ============================= -->
        <!-- Summary -->
        <!-- ============================= -->

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body p-4">

                <div class="row justify-content-end">

                    <div class="col-md-5">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Total Amount
                            </span>

                            <strong>
                                <span id="totalAmount">
                                    0.00
                                </span>
                                EGP
                            </strong>

                        </div>


                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Discount
                            </span>

                            <strong class="text-danger">

                                -
                                <span id="discountAmount">
                                    0.00
                                </span>
                                EGP

                            </strong>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between">

                            <span class="fw-bold fs-5">
                                Net Amount
                            </span>

                            <strong class="text-success fs-5">

                                <span id="netAmount">
                                    0.00
                                </span>
                                EGP

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ============================= -->
        <!-- Actions -->
        <!-- ============================= -->

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-light border px-4">

                <i class="bi bi-x-lg me-1"></i>
                Cancel

            </a>

            <button type="submit"
                    class="btn btn-primary px-4">

                <i class="bi bi-check-lg me-1"></i>
                Create Invoice

            </button>

        </div>

    </form>

</div>


<!-- ========================================= -->
<!-- Batch Template -->
<!-- ========================================= -->

<select id="batchTemplate"
        class="d-none">

    <option value="">
        -- Select Batch --
    </option>

    @foreach (var batch in ViewBag.Batches)
    {
        <option value="@batch.Value">
            @batch.Text
        </option>
    }

</select>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let invoiceItemIndex =
                    @Model.InvoiceItems.Count;


        // =========================================
        // Add Invoice Item
        // =========================================

        function addInvoiceItem() {

            const container =
                document.getElementById(
                    "invoiceItemsContainer"
                );

            const batchOptions =
                document.getElementById(
                    "batchTemplate"
                ).innerHTML;


            const emptyMessage =
                document.getElementById(
                    "emptyItemsMessage"
                );

            if (emptyMessage) {
                emptyMessage.remove();
            }


            const html = `

                        <div class="row g-3 align-items-end invoice-item-row mb-3 p-3 border rounded bg-light">

                            <!-- Product Batch -->

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Product Batch
                                </label>

                                <select name="InvoiceItems[${invoiceItemIndex}].ProductBatchId"
                                        class="form-select">

                                    ${batchOptions}

                                </select>

                            </div>


                            <!-- Quantity -->

                            <div class="col-md-2">

                                <label class="form-label fw-semibold">
                                    Quantity
                                </label>

                                <input name="InvoiceItems[${invoiceItemIndex}].Quantity"
                                       type="number"
                                       min="1"
                                       value="1"
                                       class="form-control quantity-input"
                                       onchange="calculateRowTotal(this)" />

                            </div>


                            <!-- Unit Price -->

                            <div class="col-md-3">

                                <label class="form-label fw-semibold">
                                    Unit Price
                                </label>

                                <div class="input-group">

                                    <input name="InvoiceItems[${invoiceItemIndex}].UnitPrice"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           value="0"
                                           class="form-control price-input"
                                           onchange="calculateRowTotal(this)" />

                                    <span class="input-group-text">
                                        EGP
                                    </span>

                                </div>

                            </div>


                            <!-- Total -->

                            <div class="col-md-2">

                                <label class="form-label fw-semibold">
                                    Total
                                </label>

                                <input value="0.00"
                                       class="form-control total-input"
                                       readonly />

                            </div>


                            <!-- Delete -->

                            <div class="col-md-1">

                                <button type="button"
                                        class="btn btn-outline-danger w-100"
                                        onclick="removeInvoiceItem(this)">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </div>

                        </div>
                    `;


            container.insertAdjacentHTML(
                "beforeend",
                html
            );


            invoiceItemIndex++;

            calculateInvoiceSummary();
        }


        // =========================================
        // Remove Invoice Item
        // =========================================

        function removeInvoiceItem(button) {

            const row =
                button.closest(
                    ".invoice-item-row"
                );

            if (row) {
                row.remove();
            }

            reindexInvoiceItems();

            calculateInvoiceSummary();


            const rows =
                document.querySelectorAll(
                    ".invoice-item-row"
                );

            if (rows.length === 0) {

                const container =
                    document.getElementById(
                        "invoiceItemsContainer"
                    );

                container.innerHTML = `

                            <div id="emptyItemsMessage"
                                 class="text-center py-5">

                                <i class="bi bi-cart-x display-5 text-muted"></i>

                                <h6 class="mt-3 fw-semibold">
                                    No invoice items
                                </h6>

                                <p class="text-muted mb-3">
                                    Add at least one product batch to the invoice.
                                </p>

                                <button type="button"
                                        class="btn btn-outline-primary"
                                        onclick="addInvoiceItem()">

                                    <i class="bi bi-plus-lg me-1"></i>
                                    Add First Item

                                </button>

                            </div>
                        `;
            }
        }


        // =========================================
        // Reindex Items
        // =========================================

        function reindexInvoiceItems() {

            const rows =
                document.querySelectorAll(
                    ".invoice-item-row"
                );


            rows.forEach((row, index) => {

                const inputs =
                    row.querySelectorAll(
                        "input, select"
                    );


                inputs.forEach(input => {

                    const name =
                        input.getAttribute(
                            "name"
                        );


                    if (name) {

                        input.setAttribute(
                            "name",
                            name.replace(
                                /InvoiceItems\[\d+\]/,
                                `InvoiceItems[${index}]`
                            )
                        );

                    }

                });

            });


            invoiceItemIndex =
                rows.length;
        }


        // =========================================
        // Calculate Row Total
        // =========================================

        function calculateRowTotal(element) {

            const row =
                element.closest(
                    ".invoice-item-row"
                );

            if (!row) {
                return;
            }


            const quantity =
                parseFloat(
                    row.querySelector(
                        ".quantity-input"
                    )?.value
                ) || 0;


            const price =
                parseFloat(
                    row.querySelector(
                        ".price-input"
                    )?.value
                ) || 0;


            const total =
                quantity * price;


            const totalInput =
                row.querySelector(
                    ".total-input"
                );


            if (totalInput) {

                totalInput.value =
                    total.toFixed(2);

            }


            calculateInvoiceSummary();
        }


        // =========================================
        // Calculate Invoice Summary
        // =========================================

        function calculateInvoiceSummary() {

            let total = 0;


            document
                .querySelectorAll(
                    ".invoice-item-row"
                )
                .forEach(row => {

                    const quantity =
                        parseFloat(
                            row.querySelector(
                                ".quantity-input"
                            )?.value
                        ) || 0;


                    const price =
                        parseFloat(
                            row.querySelector(
                                ".price-input"
                            )?.value
                        ) || 0;


                    total +=
                        quantity * price;

                });


            const discount =
                parseFloat(
                    document.querySelector(
                        "[name='Discount']"
                    )?.value
                ) || 0;


            const netAmount =
                Math.max(
                    0,
                    total - discount
                );


            document.getElementById(
                "totalAmount"
            ).textContent =
                total.toFixed(2);


            document.getElementById(
                "discountAmount"
            ).textContent =
                discount.toFixed(2);


            document.getElementById(
                "netAmount"
            ).textContent =
                netAmount.toFixed(2);
        }


        // =========================================
        // Discount Change
        // =========================================

        document
            .querySelector(
                "[name='Discount']"
            )
            ?.addEventListener(
                "input",
                calculateInvoiceSummary
            );


        // =========================================
        // Initial Calculation
        // =========================================

        document
            .querySelectorAll(
                ".invoice-item-row"
            )
            .forEach(row => {

                const quantity =
                    row.querySelector(
                        ".quantity-input"
                    );

                if (quantity) {
                    calculateRowTotal(
                        quantity
                    );
                }

            });

    </script>
}