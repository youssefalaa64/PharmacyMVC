@model IEnumerable<Pharmacy.ViewModels.SalesInvoiceVM>

@{
    ViewData["Title"] = "Sales Invoices";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Sales Invoices
            </h2>

            <p class="text-muted mb-0">
                Manage pharmacy sales invoices
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Create Invoice

        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Invoice #</th>
                            <th>Date</th>
                            <th>Customer / Order</th>
                            <th>Total</th>
                            <th>Discount</th>
                            <th>Net Amount</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var invoice in Model)
                        {
                            <tr>

                                <td>
                                    <span class="fw-semibold">
                                        @invoice.InvoiceNumber
                                    </span>
                                </td>

                                <td>
                                    @invoice.InvoiceDate.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    @if (invoice.CustomerId.HasValue)
                                    {
                                        <span class="badge bg-info">
                                            Offline Customer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Online Order
                                        </span>
                                    }

                                </td>

                                <td>
                                    @invoice.TotalAmount.ToString("C")
                                </td>

                                <td>
                                    @invoice.Discount.ToString("C")
                                </td>

                                <td class="fw-semibold">
                                    @invoice.NetAmount.ToString("C")
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@invoice.Id"
                                       class="btn btn-sm btn-outline-info">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@invoice.Id"
                                       class="btn btn-sm btn-outline-danger">

                                        <i class="bi bi-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>