@model Pharmacy.ViewModels.CustomerVM

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Edit Customer</h2>
        <p class="text-muted">Update customer information</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Customer Name
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                            Phone
                        </label>

                        <input asp-for="Phone"
                               class="form-control" />

                        <span asp-validation-for="Phone"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CurrentBalance"
                               class="form-label fw-semibold">
                            Current Balance
                        </label>

                        <input asp-for="CurrentBalance"
                               class="form-control"
                               type="number"
                               step="0.01" />
                    </div>

                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light border">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}