@model Pharmacy.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid py-4">

    <!-- Back -->
    <div class="mb-4">

        <a asp-area="Customer"
           asp-controller="Product"
           asp-action="Index"
           class="text-decoration-none">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back to Medicines

        </a>

    </div>


    <!-- Product Details Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-body p-4 p-lg-5">

            <div class="row g-5 align-items-center">


                <!-- Product Visual -->
                <div class="col-lg-5">

                    <div class="bg-light rounded-4
                        d-flex align-items-center
                        justify-content-center"
                         style="height: 350px;">

                        <i class="fa-solid fa-pills text-primary"
                           style="font-size: 120px;">
                        </i>

                    </div>

                </div>


                <!-- Product Information -->
                <div class="col-lg-7">


                    <!-- Category -->
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-primary-subtle
                            text-primary mb-3">

                            <i class="fa-solid fa-layer-group me-1"></i>

                            @Model.Category.Name

                        </span>
                    }


                    <!-- Name -->
                    <h1 class="fw-bold mb-2">

                        @Model.Name

                    </h1>


                    <!-- Generic Name -->
                    @if (!string.IsNullOrWhiteSpace(Model.GenericName))
                    {
                        <p class="text-muted fs-5 mb-4">

                            @Model.GenericName

                        </p>
                    }


                    <!-- Price -->
                    <div class="mb-4">

                        <span class="text-muted d-block small">
                            Price
                        </span>

                        <span class="text-success fw-bold"
                              style="font-size: 32px;">

                            @Model.Price.ToString("0.00") EGP

                        </span>

                    </div>


                    <hr />


                    <!-- Product Information -->
                    <div class="row g-3 my-3">

                        <!-- Minimum Stock -->
                        <div class="col-sm-6">

                            <div class="bg-light rounded-3 p-3">

                                <div class="text-muted small mb-1">

                                    <i class="fa-solid fa-boxes-stacked me-1"></i>

                                    Minimum Stock Level

                                </div>

                                <div class="fw-bold">

                                    @Model.MinStockLevel

                                </div>

                            </div>

                        </div>


                        <!-- Prescription -->
                        <div class="col-sm-6">

                            <div class="bg-light rounded-3 p-3">

                                <div class="text-muted small mb-1">

                                    <i class="fa-solid
                                    fa-prescription-bottle-medical
                                    me-1"></i>

                                    Prescription

                                </div>

                                <div class="fw-bold">

                                    @if (Model.RequiresPrescription)
                                    {
                                        <span class="text-warning">
                                            Required
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">
                                            Not Required
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Prescription Warning -->
                    @if (Model.RequiresPrescription)
                    {
                        <div class="alert alert-warning
                            d-flex align-items-start">

                            <i class="fa-solid
                            fa-triangle-exclamation
                            me-2 mt-1"></i>

                            <div>

                                <strong>
                                    Prescription Required
                                </strong>

                                <div class="small mt-1">

                                    This medicine requires a valid
                                    prescription before it can be ordered.

                                </div>

                            </div>

                        </div>
                    }


                    <!-- Actions -->
                    <div class="d-flex flex-column
                        flex-sm-row gap-2 mt-4">

                        <a asp-area="Customer"
                           asp-controller="Cart"
                           asp-action="Add"
                           asp-route-productId="@Model.Id"
                           class="btn btn-primary btn-lg px-4">

                            <i class="fa-solid fa-cart-plus me-2"></i>

                            Add to Cart

                        </a>


                        <a asp-area="Customer"
                           asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg px-4">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Continue Shopping

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>