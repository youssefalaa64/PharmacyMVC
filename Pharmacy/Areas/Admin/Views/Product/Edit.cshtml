@model Pharmacy.ViewModels.ProductVM

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none text-muted">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Products

        </a>

        <h2 class="fw-bold mt-3 mb-1">

            <i class="bi bi-pencil-square me-2"></i>
            Edit Product

        </h2>

        <p class="text-muted">
            Update product information and inventory settings.
        </p>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold">
                    Product Information
                </h5>

                <span class="badge bg-light text-dark border">
                    Product #@Model.Id
                </span>

            </div>

        </div>


        <div class="card-body p-4">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>


                <div class="row g-4">

                    <!-- Name -->
                    <div class="col-md-6">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Product Name
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger small"></span>

                    </div>


                    <!-- Generic Name -->
                    <div class="col-md-6">

                        <label asp-for="GenericName"
                               class="form-label fw-semibold">
                            Generic Name
                        </label>

                        <input asp-for="GenericName"
                               class="form-control" />

                        <span asp-validation-for="GenericName"
                              class="text-danger small"></span>

                    </div>


                    <!-- Price -->
                    <div class="col-md-4">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                            Price
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="Price"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger small"></span>

                    </div>


                    <!-- Min Stock -->
                    <div class="col-md-4">

                        <label asp-for="MinStockLevel"
                               class="form-label fw-semibold">
                            Minimum Stock Level
                        </label>

                        <input asp-for="MinStockLevel"
                               class="form-control" />

                        <span asp-validation-for="MinStockLevel"
                              class="text-danger small"></span>

                    </div>


                    <!-- Category -->
                    <div class="col-md-4">

                        <label asp-for="CategoryId"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="Model.Categories"
                                class="form-select">

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger small"></span>

                    </div>


                    <!-- Prescription -->
                    <div class="col-md-6">

                        <div class="card bg-light border-0">

                            <div class="card-body">

                                <div class="form-check form-switch">

                                    <input asp-for="RequiresPrescription"
                                           class="form-check-input"
                                           role="switch" />

                                    <label asp-for="RequiresPrescription"
                                           class="form-check-label fw-semibold">

                                        Requires Prescription

                                    </label>

                                </div>

                                <small class="text-muted">
                                    Enable this if a prescription is required.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light border px-4">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-save me-1"></i>
                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}