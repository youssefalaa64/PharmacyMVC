@model Pharmacy.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <!-- Warning Icon -->
                    <div class="text-center mb-4">

                        <div class="bg-danger-subtle text-danger rounded-circle
                            d-inline-flex align-items-center justify-content-center"
                             style="width:80px;height:80px;">

                            <i class="bi bi-trash3 fs-1"></i>

                        </div>

                        <h2 class="fw-bold mt-3">
                            Delete Product?
                        </h2>

                        <p class="text-muted mb-0">
                            Are you sure you want to permanently delete this product?
                        </p>

                    </div>


                    <!-- Product Information -->
                    <div class="card bg-light border-0 mb-4">

                        <div class="card-body">

                            <div class="d-flex align-items-center">

                                <div class="bg-white rounded-circle
                                    d-flex align-items-center
                                    justify-content-center me-4"
                                     style="width:70px;height:70px;">

                                    <i class="bi bi-capsule-pill fs-2 text-primary"></i>

                                </div>

                                <div>

                                    <h5 class="fw-bold mb-1">
                                        @Model.Name
                                    </h5>

                                    <p class="text-muted mb-2">
                                        @Model.GenericName
                                    </p>

                                    <div class="d-flex gap-2">

                                        <span class="badge bg-white text-dark border">
                                            ID: @Model.Id
                                        </span>

                                        <span class="badge bg-white text-dark border">
                                            @(Model.Category?.Name ?? "No Category")
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Product Details -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-4">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block">
                                    Price
                                </small>

                                <span class="fw-bold">
                                    @Model.Price.ToString("C")
                                </span>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block">
                                    Minimum Stock
                                </small>

                                <span class="fw-bold">
                                    @Model.MinStockLevel
                                </span>

                            </div>

                        </div>


                        <div class="col-md-4">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block">
                                    Prescription
                                </small>

                                @if (Model.RequiresPrescription)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">
                                        Required
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Not Required
                                    </span>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- Warning -->
                    <div class="alert alert-danger d-flex align-items-start">

                        <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>

                        <div>

                            <strong>Warning</strong>

                            <div class="small mt-1">
                                This action cannot be undone.
                                The product will be permanently deleted.
                            </div>

                        </div>

                    </div>


                    <!-- Delete Form -->
                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-light border px-4">

                                <i class="bi bi-arrow-left me-1"></i>
                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash3 me-1"></i>
                                Yes, Delete Product

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>