@model IEnumerable<Pharmacy.Models.Product>

@{
    ViewData["Title"] = "Medicines";
}

<div class="d-flex flex-column flex-md-row
    justify-content-between align-items-md-center
    gap-3 mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="fa-solid fa-pills text-primary me-2"></i>
            Medicines
        </h2>

        <p class="text-muted mb-0">
            Browse our available medicines and healthcare products.
        </p>
    </div>

</div>


@if (Model.Any())
{
    <div class="row g-4">

        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">

                <div class="card border-0 shadow-sm h-100
                    rounded-4 overflow-hidden">

                    <!-- Product Icon -->
                    <div class="bg-light d-flex
                        justify-content-center
                        align-items-center"
                         style="height: 180px;">

                        <i class="fa-solid fa-pills
                            text-primary"
                           style="font-size: 65px;">
                        </i>

                    </div>


                    <div class="card-body d-flex flex-column">

                        <!-- Category -->
                        @if (product.Category != null)
                        {
                            <div class="mb-2">

                                <span class="badge bg-primary-subtle
                                    text-primary">

                                    @product.Category.Name

                                </span>

                            </div>
                        }


                        <!-- Product Name -->

                        <h5 class="fw-bold mb-1">
                            @product.Name
                        </h5>


                        <!-- Generic Name -->
                        @if (!string.IsNullOrWhiteSpace(product.GenericName))
                        {
                            <p class="text-muted small mb-3">

                                @product.GenericName

                            </p>
                        }
                        else
                        {
                            <p class="text-muted small mb-3">
                                Medicine
                            </p>
                        }


                        <div class="mt-auto">


                            <!-- Price -->

                            <div class="d-flex
                                justify-content-between
                                align-items-center
                                mb-3">

                                <span class="text-muted small">
                                    Price
                                </span>

                                <span class="fw-bold
                                    text-success fs-5">

                                    @product.Price.ToString("0.00") EGP

                                </span>

                            </div>


                            <!-- Prescription -->
                            @if (product.RequiresPrescription)
                            {
                                <div class="small text-warning mb-3">

                                    <i class="fa-solid
                                    fa-prescription-bottle-medical
                                    me-1"></i>

                                    Prescription required

                                </div>
                            }
                            else
                            {
                                <div class="small text-success mb-3">

                                    <i class="fa-solid
                                    fa-circle-check
                                    me-1"></i>

                                    No prescription required

                                </div>
                            }


                            <!-- Details Button -->

                            <a asp-area="Customer"
                               asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-primary w-100">

                                <i class="fa-solid fa-eye me-1"></i>

                                View Details

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}
else
{
    <!-- Empty State -->

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body text-center py-5">

            <div class="mb-3">

                <i class="fa-solid fa-box-open
                    text-muted"
                   style="font-size: 60px;">
                </i>

            </div>

            <h4 class="fw-bold">
                No Medicines Available
            </h4>

            <p class="text-muted mb-0">
                There are currently no medicines available.
            </p>

        </div>

    </div>
}