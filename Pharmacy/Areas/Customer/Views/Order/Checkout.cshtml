@model Pharmacy.ViewModels.CheckoutVM
@using Pharmacy.Enums

@{
    ViewData["Title"] = "Checkout";
}

<div class="container-fluid py-4">

    <!-- Header -->

    <div class="mb-4">

        <h2 class="fw-bold mb-1">

            <i class="fa-solid fa-credit-card text-primary me-2"></i>

            Checkout

        </h2>

        <p class="text-muted mb-0">
            Complete your information to place your order.
        </p>

    </div>


    <form asp-area="Customer"
          asp-controller="Order"
          asp-action="Checkout"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row g-4">


            <!-- =====================================
                 CUSTOMER INFORMATION
            ====================================== -->

            <div class="col-lg-7">

                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-header bg-white border-0 p-4">

                        <h5 class="fw-bold mb-0">

                            <i class="fa-solid fa-location-dot
                            text-primary me-2"></i>

                            Delivery Information

                        </h5>

                    </div>


                    <div class="card-body p-4">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- Address -->

                        <div class="mb-4">

                            <label asp-for="DeliveryAddress"
                                   class="form-label fw-semibold">

                                Delivery Address

                            </label>

                            <textarea asp-for="DeliveryAddress"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Enter your full delivery address...">
                            </textarea>

                            <span asp-validation-for="DeliveryAddress"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Payment -->

                        <div class="mb-3">

                            <label asp-for="PaymentMethod"
                                   class="form-label fw-semibold">

                                Payment Method

                            </label>

                            <select asp-for="PaymentMethod"
                                    asp-items="Html.GetEnumSelectList<PaymentMethod>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="PaymentMethod"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =====================================
                     ORDER ITEMS
                ====================================== -->

                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-header bg-white border-0 p-4">

                        <div class="d-flex
                            justify-content-between
                            align-items-center">

                            <h5 class="fw-bold mb-0">

                                <i class="fa-solid fa-cart-shopping
                                text-primary me-2"></i>

                                Order Items

                            </h5>

                            <span class="badge bg-primary-subtle
                                text-primary">

                                @Model.Items.Count item(s)

                            </span>

                        </div>

                    </div>


                    <div class="card-body p-0">

                        @foreach (var item in Model.Items)
                        {
                            <div class="p-4 border-top">

                                <div class="row
                                    align-items-center
                                    g-3">

                                    <div class="col-auto">

                                        <div class="bg-light rounded-3
                                            d-flex
                                            align-items-center
                                            justify-content-center"
                                             style="width:60px;height:60px;">

                                            <i class="fa-solid fa-pills
                                                text-primary fs-4">
                                            </i>

                                        </div>

                                    </div>


                                    <div class="col">

                                        <h6 class="fw-bold mb-1">

                                            @item.ProductName

                                        </h6>

                                        <div class="text-muted small">

                                            @item.Quantity ×
                                            @item.UnitPrice.ToString("0.00")
                                            EGP

                                        </div>

                                    </div>


                                    <div class="col-auto">

                                        <span class="fw-bold">

                                            @item.TotalPrice.ToString("0.00")
                                            EGP

                                        </span>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>


            <!-- =====================================
                 ORDER SUMMARY
            ====================================== -->

            <div class="col-lg-5">

                <div class="card border-0 shadow-sm rounded-4
                    sticky-lg-top"
                     style="top:90px;">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">

                            Order Summary

                        </h5>


                        <!-- Subtotal -->

                        <div class="d-flex
                            justify-content-between
                            mb-3">

                            <span class="text-muted">
                                Subtotal
                            </span>

                            <span class="fw-semibold">

                                @Model.TotalAmount.ToString("0.00")
                                EGP

                            </span>

                        </div>


                        <!-- Discount -->

                        <div class="d-flex
                            justify-content-between
                            mb-3">

                            <span class="text-muted">
                                Discount
                            </span>

                            <span class="text-success">

                                - @Model.Discount.ToString("0.00")
                                EGP

                            </span>

                        </div>


                        <!-- Delivery -->

                        <div class="d-flex
                            justify-content-between
                            mb-3">

                            <span class="text-muted">
                                Delivery Fees
                            </span>

                            <span>

                                @Model.DeliveryFees.ToString("0.00")
                                EGP

                            </span>

                        </div>


                        <hr />


                        <!-- Net Amount -->

                        <div class="d-flex
                            justify-content-between
                            align-items-center
                            mb-4">

                            <span class="fw-bold fs-5">

                                Total

                            </span>

                            <span class="text-success
                                fw-bold fs-4">

                                @Model.NetAmount.ToString("0.00")
                                EGP

                            </span>

                        </div>


                        <!-- Place Order -->

                        <button type="submit"
                                class="btn btn-primary
                            btn-lg w-100">

                            <i class="fa-solid fa-check me-2"></i>

                            Place Order

                        </button>


                        <a asp-area="Customer"
                           asp-controller="Cart"
                           asp-action="Index"
                           class="btn btn-outline-secondary
                            w-100 mt-2">

                            <i class="fa-solid fa-arrow-left me-2"></i>

                            Back to Cart

                        </a>


                        <div class="text-center
                            text-muted small mt-3">

                            <i class="fa-solid fa-shield-halved me-1"></i>

                            Your order is securely processed.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}