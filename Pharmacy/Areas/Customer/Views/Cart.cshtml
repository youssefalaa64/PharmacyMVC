@model Pharmacy.ViewModels.CartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container my-5">
    <h2 class="mb-4"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h2>

    @if (Model.Items != null && Model.Items.Count > 0)
    {
        <div class="row g-4">
            <!-- Left Side: Item List -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Product</th>
                                        <th>Price</th>
                                        <th class="text-center">Quantity</th>
                                        <th>Subtotal</th>
                                        <th class="text-end pe-3">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(item.ProductImg))
                                                    {
                                                        <img src="@item.ProductImg" alt="@item.Name" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light rounded d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px;">
                                                            <i class="bi bi-capsule text-muted fs-4"></i>
                                                        </div>
                                                    }
                                                    <span class="fw-bold text-dark">@item.Name</span>
                                                </div>
                                            </td>
                                            <td>EGP @item.UnitPrice.ToString("N2")</td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a asp-action="Minus" asp-route-productId="@item.Id" class="btn btn-outline-secondary">-</a>
                                                    <span class="btn btn-light disabled text-dark fw-bold px-3">@item.Quantity</span>
                                                    <a asp-action="Plus" asp-route-productId="@item.Id" class="btn btn-outline-secondary">+</a>
                                                </div>
                                            </td>
                                            <td class="fw-bold">EGP @item.SubTotal.ToString("N2")</td>
                                            <td class="text-end pe-3">
                                                <a asp-action="Remove" asp-route-productId="@item.Id" class="btn btn-outline-danger btn-sm">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between py-3">
                        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                        </a>
                        <a asp-action="Clear" class="btn btn-outline-secondary btn-sm" onclick="return confirm('Clear all items from your cart?');">
                            Clear Cart
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="card-title mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-bold">EGP @Model.SubTotal.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Delivery Fee</span>
                            <span>EGP @Model.ShippingFee.ToString("N2")</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fs-5 fw-bold">Total</span>
                            <span class="fs-5 fw-bold text-success">EGP @Model.GrandTotal.ToString("N2")</span>
                        </div>
                        <a asp-area="Customer" asp-controller="Checkout" asp-action="Index" class="btn btn-success btn-lg w-100 fw-bold">
                            Proceed to Checkout
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 shadow-sm rounded bg-white">
            <i class="bi bi-cart-x text-muted display-1"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Browse products to add them to your shopping cart.</p>
            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
                Browse Products
            </a>
        </div>
    }
</div>
