@model IEnumerable<Pharmacy.Models.Product>

@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid px-4 px-lg-5 py-4">

    <!-- ================= HERO ================= -->

    <section class="hero-section rounded-4 overflow-hidden mb-5">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <div class="p-4 p-md-5">

                    <span class="badge bg-primary-subtle text-primary
                        rounded-pill px-3 py-2 mb-3">

                        <i class="fa-solid fa-store me-1"></i>
                        Welcome to our store

                    </span>

                    <h1 class="display-4 fw-bold mb-3">

                        Everything you need,
                        <span class="text-primary">
                            in one place.
                        </span>

                    </h1>

                    <p class="text-muted fs-5 mb-4">

                        Discover quality products at great prices
                        and enjoy a simple and convenient shopping experience.

                    </p>

                    <a asp-area="Customer"
                       asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-primary btn-lg px-4">

                        Shop Now

                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>

            </div>


            <div class="col-lg-5 d-none d-lg-flex
                justify-content-center align-items-center">

                <div class="hero-circle">

                    <i class="fa-solid fa-bag-shopping"></i>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= FEATURES ================= -->

    <div class="row g-3 mb-5">

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon bg-primary-subtle text-primary">

                    <i class="fa-solid fa-truck-fast"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Fast Delivery
                    </h6>

                    <p class="text-muted small mb-0">
                        Fast and reliable delivery to your door.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon bg-success-subtle text-success">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Quality Products
                    </h6>

                    <p class="text-muted small mb-0">
                        Carefully selected products you can trust.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon bg-warning-subtle text-warning">

                    <i class="fa-solid fa-headset"></i>

                </div>

                <div>

                    <h6 class="fw-bold mb-1">
                        Customer Support
                    </h6>

                    <p class="text-muted small mb-0">
                        We're always here to help.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= FEATURED PRODUCTS ================= -->

    <section>

        <div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3 mb-4">

            <div>

                <h2 class="fw-bold mb-1">
                    Featured Products
                </h2>

                <p class="text-muted mb-0">
                    Explore some of our popular products
                </p>

            </div>


            <a asp-area="Customer"
               asp-controller="Product"
               asp-action="Index"
               class="btn btn-outline-primary">

                View All Products

                <i class="fa-solid fa-arrow-right ms-2"></i>

            </a>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @foreach (var product in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">

                        <div class="product-card h-100">

                            <!-- Product Image -->

                            <a asp-area="Customer"
                               asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="text-decoration-none">

                                <div class="product-image">

                                    @if (!string.IsNullOrWhiteSpace(product.ProductImg))
                                    {
                                        <img src="~/images/@product.ProductImg"
                                             alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-box-open
                                            product-placeholder">
                                        </i>
                                    }

                                </div>

                            </a>


                            <!-- Product Information -->

                            <div class="p-3">

                                @if (product.Category != null)
                                {
                                    <div class="small text-primary
                                        fw-semibold mb-1">

                                        @product.Category.Name

                                    </div>
                                }


                                <a asp-area="Customer"
                                   asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="text-decoration-none text-dark">

                                    <h5 class="fw-bold mb-2 product-name">

                                        @product.Name

                                    </h5>

                                </a>


                                @if (!string.IsNullOrWhiteSpace(product.GenericName))
                                {
                                    <p class="text-muted small
                                        mb-3 text-truncate">

                                        @product.GenericName

                                    </p>
                                }
                                else
                                {
                                    <div class="mb-3"></div>
                                }


                                <div class="d-flex
                                    justify-content-between
                                    align-items-center">

                                    <div>

                                        <span class="fw-bold fs-5">

                                            @product.Price.ToString("0.00")

                                        </span>

                                        <small class="text-muted">
                                            EGP
                                        </small>

                                    </div>


                                    <a asp-area="Customer"
                                       asp-controller="Cart"
                                       asp-action="Add"
                                       asp-route-productId="@product.Id"
                                       class="btn btn-primary
                                        product-cart-btn"
                                       title="Add to cart">

                                        <i class="fa-solid fa-cart-plus"></i>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <div class="empty-icon mb-3">

                    <i class="fa-solid fa-box-open"></i>

                </div>

                <h5 class="fw-bold">
                    No Products Available
                </h5>

                <p class="text-muted mb-0">
                    New products will appear here soon.
                </p>

            </div>
        }

    </section>

</div>


<style>

    /* ================= HERO ================= */

    .hero-section {
        background: linear-gradient( 135deg, #f1f6ff, #ffffff );
    }

    .hero-circle {
        width: 230px;
        height: 230px;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--bs-primary);
        font-size: 90px;
    }


    /* ================= FEATURES ================= */

    .feature-card {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 16px;
        transition: 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
        }

    .feature-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }


    /* ================= PRODUCT CARD ================= */

    .product-card {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 18px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        }


    /* ================= PRODUCT IMAGE ================= */

    .product-image {
        height: 210px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 20px;
            transition: transform 0.3s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .product-placeholder {
        font-size: 60px;
        color: #adb5bd;
    }


    /* ================= PRODUCT NAME ================= */

    .product-name {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* ================= CART BUTTON ================= */

    .product-cart-btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }


    /* ================= EMPTY ================= */

    .empty-icon {
        width: 80px;
        height: 80px;
        margin: auto;
        border-radius: 50%;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: #adb5bd;
    }

</style>