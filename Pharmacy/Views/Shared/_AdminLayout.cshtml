<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pharmacy Admin</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                background-color: #f5f7fb;
                font-family: Arial, sans-serif;
            }

            .admin-wrapper {
                min-height: 100vh;
                display: flex;
            }

            /* Sidebar */

            .sidebar {
                width: 260px;
                min-height: 100vh;
                background: #1e293b;
                color: white;
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                z-index: 1000;
            }

            .sidebar-brand {
                height: 70px;
                display: flex;
                align-items: center;
                padding: 0 24px;
                border-bottom: 1px solid rgba(255,255,255,.1);
            }

                .sidebar-brand i {
                    font-size: 28px;
                    margin-right: 10px;
                    color: #38bdf8;
                }

                .sidebar-brand span {
                    font-size: 20px;
                    font-weight: 700;
                }

            .sidebar-menu {
                padding: 20px 12px;
            }

            .menu-title {
                color: #94a3b8;
                font-size: 12px;
                text-transform: uppercase;
                font-weight: 600;
                padding: 10px 14px;
                margin-top: 10px;
            }

            .sidebar-menu a {
                color: #cbd5e1;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 14px;
                border-radius: 8px;
                margin-bottom: 4px;
                transition: .2s;
            }

                .sidebar-menu a i {
                    font-size: 18px;
                }

                .sidebar-menu a:hover {
                    background: #334155;
                    color: white;
                }

                .sidebar-menu a.active {
                    background: #0ea5e9;
                    color: white;
                }

            /* Main */

            .main-content {
                margin-left: 260px;
                width: calc(100% - 260px);
                min-height: 100vh;
            }

            /* Navbar */

            .top-navbar {
                height: 70px;
                background: white;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
            }

            .page-title {
                font-size: 20px;
                font-weight: 600;
                color: #1e293b;
            }

            .admin-user {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .admin-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #0ea5e9;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
            }

            .admin-user-info {
                line-height: 1.2;
            }

                .admin-user-info small {
                    color: #64748b;
                }

            /* Content */

            .content-area {
                padding: 30px;
            }

            .page-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 25px;
            }

                .page-header h2 {
                    margin: 0;
                    font-weight: 700;
                    color: #1e293b;
                }

                .page-header p {
                    margin: 5px 0 0;
                    color: #64748b;
                }

            /* Cards */

            .admin-card {
                background: white;
                border-radius: 12px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 2px 8px rgba(0,0,0,.04);
            }

            .admin-card-header {
                padding: 18px 20px;
                border-bottom: 1px solid #e5e7eb;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .admin-card-body {
                padding: 20px;
            }

            /* Tables */

            .table {
                margin-bottom: 0;
            }

                .table thead th {
                    background: #f8fafc;
                    color: #475569;
                    font-weight: 600;
                    border-bottom: 1px solid #e2e8f0;
                }

                .table td {
                    vertical-align: middle;
                    color: #334155;
                }

            /* Buttons */

            .btn {
                border-radius: 7px;
            }

            /* Footer */

            .admin-footer {
                padding: 20px 30px;
                color: #64748b;
                font-size: 14px;
                text-align: center;
            }

            /* Mobile */

            @@media (max-width: 992px) {

                .sidebar {
                    width: 220px;
                }

                .main-content {
                    margin-left: 220px;
                    width: calc(100% - 220px);
                }
            }

            @@media (max-width: 768px) {

                .sidebar {
                    position: fixed;
                    left: -260px;
                    transition: .3s;
                }

                    .sidebar.show {
                        left: 0;
                    }

                .main-content {
                    margin-left: 0;
                    width: 100%;
                }

                .content-area {
                    padding: 20px;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="admin-wrapper">

        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar" id="sidebar">

            <!-- Brand -->

            <div class="sidebar-brand">

                <i class="bi bi-capsule-pill"></i>

                <span>Pharmacy Admin</span>

            </div>


            <!-- Menu -->

            <div class="sidebar-menu">

                <div class="menu-title">
                    Main
                </div>

                <a asp-area="Admin"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-speedometer2"></i>

                    <span>Dashboard</span>

                </a>


                <div class="menu-title">
                    Inventory
                </div>

                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index">

                    <i class="bi bi-box-seam"></i>

                    <span>Categories</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Index">

                    <i class="bi bi-box-seam"></i>

                    <span>Products</span>

                </a>


                <a asp-area="Admin"
                   asp-controller="ProductBatch"
                   asp-action="Index">

                    <i class="bi bi-boxes"></i>

                    <span>Product Batches</span>

                </a>


                <a asp-area="Admin"
                   asp-controller="Customer"
                   asp-action="Index">

                    <i class="bi bi-people"></i>

                    <span>Customers</span>

                </a>


                <div class="menu-title">
                    Sales
                </div>

                <a asp-area="Admin"
                   asp-controller="SalesInvoice"
                   asp-action="Index">

                    <i class="bi bi-receipt"></i>

                    <span>Sales Invoices</span>

                </a>


                <a asp-area="Admin"
                   asp-controller="Order"
                   asp-action="Index">

                    <i class="bi bi-cart3"></i>

                    <span>Orders</span>

                </a>


                <div class="menu-title">
                    Administration
                </div>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index">

                    <i class="bi bi-person-gear"></i>

                    <span>Users</span>

                </a>

                <a asp-area="Customer"
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-primary rounded-3 px-4">

                    <i class="fa-solid fa-store me-2"></i>
                    Go to Store

                </a>

            </div>

        </aside>


        <!-- ================= MAIN CONTENT ================= -->

        <main class="main-content">

            <!-- Top Navbar -->

            <nav class="top-navbar">

                <div class="d-flex align-items-center gap-3">

                    <button class="btn btn-light d-md-none"
                            type="button"
                            onclick="toggleSidebar()">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="page-title">

                        @ViewData["Title"]

                    </div>

                </div>


                <!-- Admin User -->

                <div class="admin-user">

                    <div class="admin-avatar">

                        <i class="bi bi-person"></i>

                    </div>

                    <div class="admin-user-info">

                        <strong>Admin</strong>

                        <br />

                        <small>Administrator</small>

                    </div>

                </div>

            </nav>


            <!-- Page Content -->

            <section class="content-area">

                @RenderBody()

            </section>


            <!-- Footer -->

            <footer class="admin-footer">

                © @DateTime.Now.Year Pharmacy Management System

            </footer>

        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <script>

            function toggleSidebar() {

                document
                    .getElementById("sidebar")
                    .classList.toggle("show");

            }

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>